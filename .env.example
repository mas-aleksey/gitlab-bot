# Telegram Bot API token issued by @BotFather.
BOT_TOKEN=

# URL-safe base64-encoded 32-byte key used to encrypt GitLab PATs at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Secret used to HMAC-sign invite codes. Min 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INVITE_SALT=replace-me-with-a-real-secret-at-least-32-chars

# SQLAlchemy async URL for SQLite.
DATABASE_URL=sqlite+aiosqlite:////data/bot.db

# Root log level.
LOG_LEVEL=INFO

# ---- test-only ----
# PAT used to record VCR cassettes against a real GitLab instance.
PAT=
# Base URL of the GitLab instance used for VCR recording (no trailing slash).
GITLAB_URL=https://gl.example.com
# A group or project path in that instance for scope-resolution tests.
GITLAB_SCOPE_PATH=
